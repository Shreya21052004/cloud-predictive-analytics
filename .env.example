# Copy to .env and fill in, or export these directly in your shell.
# `python-dotenv` isn't wired in by default — either `source` this file
# (after renaming values) or `export $(cat .env | xargs)` before running.

# --- Mongo ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mydb
# MONGO_OUTPUT_DB=mydb   # optional: write predictions/summaries to a different db

# --- LLM (project summaries) ---
# Local Ollama server — no API key, no quota. Run `ollama serve` and
# `ollama pull qwen3:8b` first. Point OLLAMA_HOST elsewhere if Ollama
# isn't running on this machine.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
# LLM_REQUEST_TIMEOUT_S=25
# LLM_MAX_RETRIES=2

# Only needed if you switch LLM_PROVIDER=anthropic (optional cloud fallback)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- Kafka (optional second ingestion source, alongside Mongo change streams) ---
# Pass --enable-kafka to run_pipeline.py to turn this on.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_ACCOUNT_TOPIC=cloud-account-metrics
# KAFKA_INVENTORY_TOPIC=service-resource-inventory
# KAFKA_GROUP_ID=jsr-pipeline
# KAFKA_AUTO_OFFSET_RESET=earliest
# Only needed for managed Kafka (Confluent Cloud, MSK, etc.) — leave unset for local PLAINTEXT:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
